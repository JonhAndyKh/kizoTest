{
  "rewrites": [
    {
      "source": "/paid",
      "destination": "/paid.html"
    },
    {
      "source": "/paid/",
      "destination": "/paid.html"
    },
    {
      "source": "/order/:invoiceId",
      "destination": "/paid.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
